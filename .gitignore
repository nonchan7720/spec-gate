node_modules/
/spec-gate
# bin/spec-gate はコミットする入口のスクリプト（本物のバイナリは bin/spec-gate.real）
bin/*
!bin/spec-gate
.DS_Store
.env

# goreleaser output
/dist/

# spec-gate
.spec-gate/generated/
# extract / reverse をサブエージェントに委譲するときのプロンプトと回答（collect が終わったら消える）
.spec-gate-llm/
# 通り方のログ（check --hook が追記する。spec-gate trace で要約）
.spec-gate/trace.jsonl
# 判定の記録（.spec-gate/review-decisions.jsonl）はコミットする。ブレーカーと audit が読むので、clone ごとに消えてはいけない
test-results/

# 人間の引き継ぎメモ（リポジトリには入れない）
HANDOFF.md

# feedback-gate（hook-gate）の状態とログ
.claude/.gate-status/
