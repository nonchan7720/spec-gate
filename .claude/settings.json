{
  "env": {
    "MCP_TIMEOUT": "120000"
  },
  "permissions": {
    "deny": [
      "Read(./holdout/**)",
      "Edit(./holdout/**)",
      "Write(./holdout/**)"
    ]
  },
  "extraKnownMarketplaces": {
    "claude-hook-gate": {
      "source": { "source": "github", "repo": "nonchan7720/claude-hook-gate" }
    }
  },
  "enabledPlugins": {
    "feedback-gate@claude-hook-gate": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/session-start.sh\""
          },
          {
            "type": "command",
            "timeout": 10,
            "command": "command -v mise >/dev/null && mise exec -- depgraph hook session-start; exit 0"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "\"$CLAUDE_PROJECT_DIR/bin/spec-gate\" -C \"$CLAUDE_PROJECT_DIR\" guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "command": "\"$CLAUDE_PROJECT_DIR/bin/spec-gate\" -C \"$CLAUDE_PROJECT_DIR\" review record --by nonchan7720"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "command -v mise >/dev/null && mise exec -- depgraph hook prompt; exit 0"
          }
        ]
      }
    ]
  }
}
